# LIVO backend — copy this file to backend/.env
MONGO_URL=mongodb://localhost:27017
DB_NAME=livo

# Required only for Live conversation / AI-only features.
# The local dictionary + Word Practice work without OpenAI runtime calls.
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000

OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_REASONING_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: image game
PEXELS_API_KEY=

# Optional source overrides for offline dictionary import
FREEDICT_ENG_HUN_URL=https://raw.githubusercontent.com/freedict/fd-dictionaries/master/eng-hun/eng-hun.tei
OEWN_XML_URL=https://en-word.net/downloads/english-wordnet-2025.xml.gz
